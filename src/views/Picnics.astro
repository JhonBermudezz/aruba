---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ExperienceCards from '../components/ExperienceCards.astro';
import Included from '../components/Included.astro';
import Timeline from '../components/Timeline.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { SITE } from '../data/site.js';
import { getData, t, route, routePair, expHref } from '../i18n.js';
import { breadcrumbSchema, faqSchema } from '../data/schema.js';

const { lang = 'en' } = Astro.props;
const ui = t(lang);
const { EXPERIENCES, TIMELINES } = getData(lang);
const crumbs = [{ href: route(lang, 'home'), label: ui.home }, { href: route(lang, 'picnics'), label: ui.picnics }];
const faqKeys = ['price', 'length', 'beaches', 'deposit'];
const list = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  itemListElement: EXPERIENCES.map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: e.name, url: `${SITE.url}${expHref(lang, e)}` })),
};
const C = {
  en: {
    title: 'Private beach picnics in Aruba | One Happy Picnic',
    description: 'Six ways to picnic on the beach in Aruba: sunset and moonlight picnics, proposal setups, birthdays and anniversaries, group picnics and charcuterie boards to go.',
    h1: 'Private beach picnics in Aruba',
    intro: 'Pick the picnic that fits your trip. Every setup is private, and Zoe and her team set it up on the sand before you arrive.',
    ask: 'Ask a question', alt: 'A bamboo teepee with pink flowers over a picnic table and cushions on the sand at sunset', faq: 'Questions about our picnics',
  },
  es: {
    title: 'Picnics privados en la playa en Aruba | One Happy Picnic',
    description: 'Seis formas de hacer un picnic en la playa en Aruba: al atardecer y de noche, propuestas de matrimonio, cumpleaños y aniversarios, grupos y tablas de charcutería.',
    h1: 'Picnics privados en la playa en Aruba',
    intro: 'Elige el picnic que va con tu viaje. Cada montaje es privado, y Zoe y su equipo lo arman en la arena antes de que llegues.',
    ask: 'Hacer una pregunta', alt: 'Tipi de bambú con flores rosadas sobre una mesa de picnic y cojines en la arena al atardecer', faq: 'Preguntas sobre nuestros picnics',
  },
}[lang];
---
<Base lang={lang} alt={routePair('picnics')} title={C.title} description={C.description} jsonld={[breadcrumbSchema(crumbs), list, faqSchema(faqKeys, lang)]}>
  <PageHero
    lang={lang}
    crumbs={crumbs}
    title={C.h1}
    intro={C.intro}
    cta={{ href: route(lang, 'book'), label: ui.book }}
    secondary={{ href: route(lang, 'contact'), label: C.ask }}
    image={{ img: 'p-sunset', w: 1000, h: 1250, alt: C.alt }}
  />
  <section class="section section--tight" aria-label={ui.picnics}>
    <div class="container">
      <ExperienceCards items={EXPERIENCES} lang={lang} />
    </div>
  </section>
  <Included lang={lang} />
  <Timeline data={TIMELINES.picnic} lang={lang} />
  <Faq keys={faqKeys} heading={C.faq} lang={lang} />
  <FinalCta lang={lang} />
</Base>
