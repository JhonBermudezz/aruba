---
import Sprite from '../components/Sprite.astro';
import { SITE } from '../data/site.js';
import { getData, t, route, expHref } from '../i18n.js';

const {
  lang = 'en',
  // Same page in each language, e.g. { en: '/about/', es: '/es/nosotros/' }. Drives the switcher and hreflang.
  alt,
  title,
  description,
  image = SITE.ogImage,
  imageAlt,
  jsonld = [],
  noindex = false,
  preload = [],
  bare = false,
  ogType = 'website',
} = Astro.props;

const ui = t(lang);
const other = lang === 'es' ? 'en' : 'es';
const { EXPERIENCES } = getData(lang);
const path = Astro.url.pathname;
const canonical = `${SITE.url}${path}`;
const home = route(lang, 'home');
const isCurrent = (href) => path === href || (href !== home && path.startsWith(href));
const nav = ui.nav.map(([key, label]) => ({ href: route(lang, key), label }));
const switchHref = alt?.[other] || route(other, 'home');
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {alt && (
    <>
      <link rel="alternate" hreflang="en" href={`${SITE.url}${alt.en}`}>
      <link rel="alternate" hreflang="es" href={`${SITE.url}${alt.es}`}>
      <link rel="alternate" hreflang="x-default" href={`${SITE.url}${alt.en}`}>
    </>
  )}
  {(noindex || SITE.staging) && <meta name="robots" content="noindex">}
  <meta name="theme-color" content="#FFFAF6">
  <meta property="og:type" content={ogType}>
  <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'}>
  <meta property="og:site_name" content={SITE.name}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={`${SITE.url}${image}`}>
  <meta property="og:image:alt" content={imageAlt || ui.ogAlt}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&display=swap">
  {preload.map((p) => <link rel="preload" as="image" href={p.href} media={p.media}>)}
  <link rel="stylesheet" href="/assets/css/styles.css">
  <script is:inline>
    document.documentElement.classList.add('js');
    setTimeout(function () { if (!window.__ohpReady) document.documentElement.classList.remove('js'); }, 3000);
  </script>
  {jsonld.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />)}
</head>
<body>
<Sprite />
<a class="skip-link" href="#main">{ui.skip}</a>

{!bare && (
  <>
    <div class="nav-wrap">
      <nav class="nav" aria-label="Main">
        <a class="nav__brand" href={home} aria-label={ui.homeLabel}>
          <img src="/assets/img/logo-96.webp" width="40" height="40" alt="">
          <span>One Happy Picnic</span>
        </a>
        <div class="nav__links">
          {nav.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </div>
        <a class="lang-switch" href={switchHref} hreflang={other} lang={other} aria-label={ui.switchLabel}><svg class="icon icon-sm" aria-hidden="true"><use href="#i-globe-simple"/></svg>{ui.switchShort}</a>
        <a class="btn btn--primary btn--sm nav__cta" href={route(lang, 'book')}>{ui.book}</a>
        <button class="burger" type="button" aria-expanded="false" aria-controls="menu" aria-label={ui.openMenu}>
          <span></span><span></span>
        </button>
      </nav>
    </div>

    <div class="menu" id="menu" aria-hidden="true">
      <ul>
        <li><a class="menu__link" href={home} aria-current={path === home ? 'page' : undefined}>{ui.home}</a></li>
        {nav.map((item) => <li><a class="menu__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>)}
      </ul>
      <div class="menu__foot">
        <a class="btn btn--primary" href={route(lang, 'book')}>{ui.bookYour} <svg class="icon icon-move"><use href="#i-arrow-right"/></svg></a>
        <a class="btn btn--ghost" href={SITE.instagram} target="_blank" rel="noopener"><svg class="icon"><use href="#i-instagram-logo"/></svg> Instagram</a>
        <a class="btn btn--ghost" href={switchHref} hreflang={other} lang={other}><svg class="icon"><use href="#i-globe-simple"/></svg> {lang === 'es' ? 'English' : 'Español'}</a>
      </div>
    </div>
  </>
)}

<main id="main">
  <slot />
</main>

{!bare && (
  <footer class="footer">
    <div class="container">
      <div class="footer__grid">
        <div class="footer__brand">
          <img src="/assets/img/logo-192.webp" width="64" height="64" alt={ui.logoAlt} loading="lazy">
          <p>{ui.footerAbout}</p>
        </div>
        <div>
          <h2>{ui.picnics}</h2>
          <ul>
            {EXPERIENCES.map((e) => <li><a href={expHref(lang, e)}>{e.name}</a></li>)}
          </ul>
        </div>
        <div>
          <h2>{ui.company}</h2>
          <ul>
            <li><a href={route(lang, 'about')}>{ui.aboutZoe}</a></li>
            <li><a href={route(lang, 'reviews')}>{ui.reviews}</a></li>
            <li><a href={route(lang, 'blog')}>{ui.blog}</a></li>
            <li><a href={route(lang, 'faq')}>{ui.faq}</a></li>
            <li><a href={route(lang, 'contact')}>{ui.contact}</a></li>
            <li><a href={route(lang, 'book')}>{ui.book}</a></li>
          </ul>
        </div>
        <div>
          <h2>{ui.follow}</h2>
          <ul>
            <li><a href={SITE.instagram} target="_blank" rel="noopener"><svg class="icon icon-sm"><use href="#i-instagram-logo"/></svg> Instagram</a></li>
            <li data-wa-item hidden><a href="#" data-wa><svg class="icon icon-sm"><use href="#i-whatsapp-logo"/></svg> WhatsApp</a></li>
            <li data-phone-item hidden><a href="#" data-call><svg class="icon icon-sm"><use href="#i-l-phone"/></svg> {ui.callUs}</a></li>
          </ul>
          <h2 class="footer__sub">{ui.legal}</h2>
          <ul>
            <li><a href={route(lang, 'privacy')}>{ui.privacy}</a></li>
            <li><a href={route(lang, 'terms')}>{ui.terms}</a></li>
            <li><a href={switchHref} hreflang={other} lang={other}>{lang === 'es' ? 'English' : 'Español'}</a></li>
          </ul>
        </div>
      </div>
      <div class="footer__base">
        <span>&copy; <span data-year>2026</span> One Happy Picnic Aruba</span>
        <span>{SITE.handle}</span>
      </div>
    </div>
  </footer>
)}

{!bare && (
  <div class="dock" data-dock hidden>
    <a class="dock__btn dock__btn--primary" href="#" data-wa hidden><svg class="icon"><use href="#i-whatsapp-logo"/></svg><span>WhatsApp</span></a>
    <a class="dock__btn" href="#" data-call hidden><svg class="icon"><use href="#i-l-phone"/></svg><span>{ui.call}</span></a>
  </div>
)}

<dialog class="lightbox" id="lightbox" aria-label={ui.photoViewer}>
  <button class="lightbox__close" type="button" aria-label={ui.closePhoto}><svg class="icon"><use href="#i-x"/></svg></button>
  <img src="/assets/img/g-golden-table-900.webp" alt="">
</dialog>

<script is:inline src="/assets/js/main.js" defer></script>
</body>
</html>
