---
import { img } from '../data/site.js';
import { t, route } from '../i18n.js';
const { lang = 'en' } = Astro.props;
const ui = t(lang);
const { href = route(lang, 'book'), title = ui.finalTitle, text = ui.finalText, label = ui.bookYour } = Astro.props;
---
<section class="final" aria-labelledby="final-title">
  <div class="final__bg"><img src={img('cta-sunset-960.webp')} srcset={`${img('cta-sunset-960.webp')} 960w, ${img('cta-sunset-1440.webp')} 1440w`} sizes="100vw" width="1440" height="810" loading="lazy" alt=""></div>
  <div class="container final__inner">
    <p class="final__sun reveal" data-final-sunset>{ui.finalSun}</p>
    <h2 id="final-title" class="reveal">{title}</h2>
    <p class="reveal">{text}</p>
    <a class="btn btn--light reveal" href={href}>{label} <svg class="icon icon-move"><use href="#i-arrow-right"/></svg></a>
  </div>
</section>
