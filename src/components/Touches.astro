---
import { img } from '../data/site.js';
import { t } from '../i18n.js';
const { lang = 'en' } = Astro.props;
const ui = t(lang);
const { heading = ui.touchesHeading } = Astro.props;
const items = ['touch-photos', 'touch-note', 'touch-flowers'].map((file, i) => ({ file, caption: ui.touches[i], alt: ui.touchesAlt[i] }));
---
<section class="section section--lagoon" aria-labelledby="touch-title">
  <div class="container split split--flip">
    <div class="touches">
      {items.map((t, i) => (
        <figure class={`touch reveal${['', ' reveal-d1', ' reveal-d2'][i]}`} style="margin:0;">
          <div class="photo-frame"><img src={img(`${t.file}-480.webp`)} srcset={`${img(`${t.file}-480.webp`)} 480w, ${img(`${t.file}-720.webp`)} 720w`} sizes="(min-width: 1024px) 220px, 62vw" width="720" height="900" loading="lazy" alt={t.alt}></div>
          <figcaption>{t.caption}</figcaption>
        </figure>
      ))}
    </div>
    <div class="quote-block reveal">
      <h2 class="h2" id="touch-title">{heading}</h2>
      <blockquote lang="en">
        <p>&ldquo;She printed off photos of my partner and I, had me write a little note and copied it into a cute card. The lights, the location of the beach. Just amazing, all of it.&rdquo;</p>
      </blockquote>
      <div class="person"><div class="person__text"><strong>Taylor T.</strong><span>{ui.touchesWho}</span></div></div>
    </div>
  </div>
</section>
