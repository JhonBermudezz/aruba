---
import { img } from '../data/site.js';
const { heading = 'The details guests mention in their reviews' } = Astro.props;
const items = [
  { file: 'touch-photos', caption: 'Printed photos of the two of you', alt: 'Printed couple photos hanging from a line between two bamboo poles above a red heart rug on the sand' },
  { file: 'touch-note', caption: 'Your note, copied onto a card', alt: 'A framed you and me always card beside red roses and a candle on a turquoise table runner' },
  { file: 'touch-flowers', caption: 'Fresh flowers on the table', alt: 'Pink and purple flowers in a glass vase next to a framed wine quote on a wooden picnic table' },
];
---
<section class="section section--lagoon" aria-labelledby="touch-title">
  <div class="container split split--flip">
    <div class="touches">
      {items.map((t, i) => (
        <figure class={`touch reveal${['', ' reveal-d1', ' reveal-d2'][i]}`} style="margin:0;">
          <div class="photo-frame"><img src={img(`${t.file}-480.webp`)} srcset={`${img(`${t.file}-480.webp`)} 480w, ${img(`${t.file}-720.webp`)} 720w`} sizes="(min-width: 1024px) 220px, 62vw" width="720" height="900" loading="lazy" alt={t.alt}></div>
          <figcaption>{t.caption}</figcaption>
        </figure>
      ))}
    </div>
    <div class="quote-block reveal">
      <h2 class="h2" id="touch-title">{heading}</h2>
      <blockquote>
        <p>&ldquo;She printed off photos of my partner and I, had me write a little note and copied it into a cute card. The lights, the location of the beach. Just amazing, all of it.&rdquo;</p>
      </blockquote>
      <div class="person"><div class="person__text"><strong>Taylor T.</strong><span>Sunset picnic for a 10 year anniversary</span></div></div>
    </div>
  </div>
</section>
