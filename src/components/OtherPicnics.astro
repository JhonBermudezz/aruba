---
import { img } from '../data/site.js';
import { getData, t, expHref } from '../i18n.js';
const { exclude, lang = 'en' } = Astro.props;
const ui = t(lang);
const { EXPERIENCES } = getData(lang);
const items = EXPERIENCES.filter((e) => e.slug !== exclude);
---
<section class="section" aria-labelledby="more-title">
  <div class="container">
    <div class="section-head reveal">
      <h2 class="h2" id="more-title">{ui.morePicnics}</h2>
    </div>
    <ul class="mini-cards">
      {items.map((e, i) => (
        <li class={`mini-card reveal${['', ' reveal-d1', ' reveal-d2'][i % 3]}`}>
          <a href={expHref(lang, e)}>
            <img src={img(`${e.card.img}-640.webp`)} width="640" height="480" loading="lazy" alt="">
            <span>{e.name}</span>
            <svg class="icon" aria-hidden="true"><use href="#i-arrow-right"/></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
