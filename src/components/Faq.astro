---
import { getData, t, route } from '../i18n.js';
const { lang = 'en' } = Astro.props;
const ui = t(lang);
const { FAQS } = getData(lang);
const { keys, heading = ui.faqHeading, lead = ui.faqLead, more = true, id = 'faq' } = Astro.props;
---
<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container faq-layout">
    <div class="section-head reveal">
      <h2 class="h2" id={`${id}-title`}>{heading}</h2>
      <p class="lead">{lead}</p>
      {more && <a class="text-link" href={route(lang, 'faq')}>{ui.faqMore} <svg class="icon"><use href="#i-arrow-right"/></svg></a>}
    </div>
    <div class="faq reveal">
      {keys.map((k) => (
        <details>
          <summary>{FAQS[k].q} <svg class="icon"><use href="#i-plus"/></svg></summary>
          <div class="faq__answer">{FAQS[k].a.map((p) => <p>{p}</p>)}</div>
        </details>
      ))}
    </div>
  </div>
</section>
