---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import { SITE } from '../data/site.js';
import { business, breadcrumbSchema } from '../data/schema.js';

const crumbs = [{ href: '/', label: 'Home' }, { href: '/contact/', label: 'Contact' }];
const contactPage = { '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contact One Happy Picnic Aruba', url: `${SITE.url}/contact/`, about: { '@id': `${SITE.url}/#business` } };
const maps = (q) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
---
<Base
  title="Contact One Happy Picnic Aruba"
  description="Message One Happy Picnic Aruba for picnic dates, prices, proposal setups and charcuterie board orders. We reply on WhatsApp and Instagram."
  jsonld={[contactPage, business, breadcrumbSchema(crumbs)]}
>
  <PageHero crumbs={crumbs} title="Contact One Happy Picnic" intro="Message us for dates, prices and custom setups. To request a date, the booking form is the fastest way." cta={{ href: '/book/', label: 'Book a picnic' }} />

  <section class="section section--sand section--tight">
    <div class="container booking">
      <div class="booking__aside reveal">
        <h2 class="h3">Message us</h2>
        <ul class="channels">
          <li><a href={SITE.instagramDm} target="_blank" rel="noopener"><svg class="feature-icon" aria-hidden="true"><use href="#i-l-instagram-logo"/></svg><span><strong>Instagram</strong><span>{SITE.handle}</span></span></a></li>
          <li data-wa-item hidden><a href="#" data-wa><svg class="feature-icon" aria-hidden="true"><use href="#i-l-whatsapp-logo"/></svg><span><strong>WhatsApp</strong><span>Message us any time</span></span></a></li>
          <li data-phone-item hidden><a href="#" data-call><svg class="feature-icon" aria-hidden="true"><use href="#i-l-phone"/></svg><span><strong>Call</strong><span data-phone-text></span></span></a></li>
          <li data-email-item hidden><a href="#" data-email><svg class="feature-icon" aria-hidden="true"><use href="#i-l-envelope-simple"/></svg><span><strong>Email</strong><span data-email-text></span></span></a></li>
        </ul>
        <h2 class="h3 channels__title">Where we set up</h2>
        <ul class="beaches">
          <li><a href={maps('Eagle Beach, Aruba')} target="_blank" rel="noopener">Eagle Beach <svg class="icon icon-sm"><use href="#i-arrow-up-right"/></svg></a></li>
          <li><a href={maps('Surfside Beach, Aruba')} target="_blank" rel="noopener">Surfside Beach <svg class="icon icon-sm"><use href="#i-arrow-up-right"/></svg></a></li>
          <li>Other beaches on request</li>
        </ul>
      </div>

      <div class="form-card reveal reveal-d1">
        <form class="compose" data-compose data-intro="Hi One Happy Picnic, I have a question." data-subject="message" novalidate>
          <div class="form-grid">
            <div class="field">
              <label for="c-name">Your name</label>
              <input class="input" id="c-name" name="name" type="text" autocomplete="name" required data-label="Name" aria-describedby="c-name-error">
              <p class="field__error" id="c-name-error" role="alert"></p>
            </div>
            <div class="field">
              <label for="c-email">Email</label>
              <input class="input" id="c-email" name="email" type="email" autocomplete="email" inputmode="email" required data-label="Email" aria-describedby="c-email-error">
              <p class="field__error" id="c-email-error" role="alert"></p>
            </div>
            <div class="field field--full">
              <label for="c-topic">Topic</label>
              <select class="input" id="c-topic" name="topic" data-label="Topic">
                <option>A question about a picnic</option>
                <option>A proposal or custom setup</option>
                <option>A charcuterie board order</option>
                <option>Something else</option>
              </select>
            </div>
            <div class="field field--full">
              <label for="c-message">Message</label>
              <textarea class="input" id="c-message" name="message" rows="5" required data-label="Message" aria-describedby="c-message-error" placeholder="Your dates, group size or question"></textarea>
              <p class="field__error" id="c-message-error" role="alert"></p>
            </div>
          </div>
          <div class="form-foot">
            <button class="btn btn--primary" type="submit"><svg class="icon"><use href="#i-whatsapp-logo"/></svg> Send my message</button>
            <p>We reply on WhatsApp or Instagram.</p>
          </div>
          <p class="form-status" role="alert" hidden></p>
        </form>
        <div class="success" data-compose-success hidden tabindex="-1">
          <span class="success__badge" aria-hidden="true"><svg class="icon"><use href="#i-l-check"/></svg></span>
          <h3>Your message is ready to send</h3>
          <p data-success-copy>Send it to us and we will reply.</p>
          <div class="success__actions">
            <a class="btn btn--primary" data-send-link href="#" target="_blank" rel="noopener"><svg class="icon"><use href="#i-whatsapp-logo" data-send-icon/></svg> <span data-send-label>Open WhatsApp</span></a>
            <button class="btn btn--ghost" type="button" data-copy><svg class="icon"><use href="#i-copy"/></svg> <span>Copy message</span></button>
            <button class="btn btn--ghost" type="button" data-edit>Edit message</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Faq keys={['price', 'advance', 'beaches', 'delivery']} heading="Quick answers" />
</Base>
