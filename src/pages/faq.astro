---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FinalCta from '../components/FinalCta.astro';
import { FAQS, FAQ_GROUPS } from '../data/site.js';
import { breadcrumbSchema, faqSchema } from '../data/schema.js';

const crumbs = [{ href: '/', label: 'Home' }, { href: '/faq/', label: 'FAQ' }];
const allKeys = FAQ_GROUPS.flatMap((g) => g.keys);
---
<Base
  title="Beach picnic FAQ: prices, booking and weather | One Happy Picnic Aruba"
  description="Answers about our beach picnics in Aruba: prices, deposits, cancellation, weather, beaches, proposals, birthdays and charcuterie board delivery."
  jsonld={[faqSchema(allKeys), breadcrumbSchema(crumbs)]}
>
  <PageHero crumbs={crumbs} title="Questions about our picnics" intro="Prices, booking, weather and the details of each picnic. Message us on Instagram or WhatsApp if your question is not here.">
    <nav class="faq-jump" aria-label="FAQ topics">
      {FAQ_GROUPS.map((g) => <a href={`#${g.id}`}>{g.title}</a>)}
    </nav>
  </PageHero>
  <section class="section section--tight">
    <div class="container faq-groups">
      {FAQ_GROUPS.map((g) => (
        <section class="faq-group reveal" id={g.id} aria-labelledby={`${g.id}-title`}>
          <h2 class="h3" id={`${g.id}-title`}>{g.title}</h2>
          <div class="faq">
            {g.keys.map((k) => (
              <details>
                <summary>{FAQS[k].q} <svg class="icon"><use href="#i-plus"/></svg></summary>
                <div class="faq__answer">{FAQS[k].a.map((p) => <p>{p}</p>)}</div>
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
  <FinalCta />
</Base>
