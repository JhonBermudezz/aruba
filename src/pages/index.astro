---
import Base from '../layouts/Base.astro';
import ExperienceCards from '../components/ExperienceCards.astro';
import Included from '../components/Included.astro';
import Touches from '../components/Touches.astro';
import Timeline from '../components/Timeline.astro';
import Reviews from '../components/Reviews.astro';
import Polaroids from '../components/Polaroids.astro';
import BookingSection from '../components/BookingSection.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Pill from '../components/Pill.astro';
import Stars from '../components/Stars.astro';
import { EXPERIENCES, TIMELINES } from '../data/site.js';
import { business, faqSchema } from '../data/schema.js';

const faqKeys = ['length', 'beaches', 'price', 'food', 'deposit', 'cancellation', 'weather', 'advance'];
const gallery = ['g-golden-table', 'g-kiss', 'g-torches', 'g-long-table', 'g-teepee-sun', 'g-family', 'g-silhouettes', 'g-birthday-23', 'g-table-spread'];
---
<Base
  title="One Happy Picnic Aruba | Private sunset picnics on the beach"
  description="Private beach picnics in Aruba, styled before you arrive. Sunset and moonlight picnics, proposals, birthdays and charcuterie boards on Eagle Beach and Surfside."
  jsonld={[business, faqSchema(faqKeys)]}
  preload={[{ href: '/assets/img/hero-wide-1920.webp', media: '(min-width: 768px)' }, { href: '/assets/img/hero-tall-1080.webp', media: '(max-width: 767px)' }]}
>
  <header class="hero" id="top">
    <div class="hero__media">
      <picture>
        <source media="(max-width: 767px)" srcset="/assets/img/hero-tall-720.webp 720w, /assets/img/hero-tall-1080.webp 1080w" sizes="100vw">
        <source media="(min-width: 768px)" srcset="/assets/img/hero-wide-1280.webp 1280w, /assets/img/hero-wide-1920.webp 1920w, /assets/img/hero-wide-2560.webp 2560w" sizes="100vw">
        <img src="/assets/img/hero-wide-1920.webp" width="1920" height="1072" fetchpriority="high"
             alt="A bamboo teepee wrapped in pink flowers over a low wooden picnic table, white cushions and a turquoise blanket on the sand at sunset in Aruba">
      </picture>
    </div>
    <div class="hero__inner container">
      <div class="hero__panel">
        <h1 class="hero__title">
          <span class="line">Sunset picnics on the sand,</span>
          <span class="line">styled before you arrive</span>
        </h1>
        <p class="hero__sub">Zoe and her team set up your private picnic on Eagle Beach or Surfside, flowers and grazing board included. You arrive at golden hour and we clean up after you leave.</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="#book">Book your picnic <svg class="icon icon-move"><use href="#i-arrow-right"/></svg></a>
          <span class="sunset-chip"><svg class="icon"><use href="#i-sun-horizon"/></svg> <span data-sunset-label>Sunset today</span> <strong class="mono" data-sunset-today>6:22 PM</strong></span>
        </div>
        <div class="hero__proof">
          <Stars />
          <p><q>My daughter and her husband rated it 10 out of 10.</q> Susan R. sent a sunset picnic to her daughter's honeymoon.</p>
        </div>
      </div>
    </div>
  </header>

  <section class="trust" aria-label="What every picnic includes">
    <div class="container">
      <ul>
        <li class="reveal"><svg class="feature-icon" aria-hidden="true"><use href="#i-l-broom"/></svg><div class="trust__text"><strong>We set up and clean up</strong></div></li>
        <li class="reveal reveal-d1"><svg class="feature-icon" aria-hidden="true"><use href="#i-l-certificate"/></svg><div class="trust__text"><strong>Beach permit included</strong></div></li>
        <li class="reveal reveal-d2"><svg class="feature-icon" aria-hidden="true"><use href="#i-l-fork-knife"/></svg><div class="trust__text"><strong>Food and drinks included</strong></div></li>
        <li class="reveal reveal-d3"><svg class="feature-icon" aria-hidden="true"><use href="#i-l-shield-check"/></svg><div class="trust__text"><strong>24 hour free cancellation</strong></div></li>
      </ul>
    </div>
  </section>

  <section class="section" id="experiences" aria-labelledby="exp-title">
    <div class="container">
      <div class="gallery-head">
        <div class="section-head reveal">
          <h2 class="h2" id="exp-title">Pick your <Pill file="pill-sunset.webp" /> moment</h2>
          <p class="lead">Every picnic is private. Tell us the occasion and we style the table for it.</p>
        </div>
        <a class="btn btn--ghost reveal" href="/picnics/">All picnics <svg class="icon icon-move"><use href="#i-arrow-right"/></svg></a>
      </div>
      <ExperienceCards items={EXPERIENCES} />
    </div>
  </section>

  <section class="tagline section--sand" aria-label="Our promise">
    <div class="container">
      <div class="tagline__inner">
        <p class="tagline__text" data-reveal-words>We set your table on the sand before you leave the hotel. You sit down and <span data-accent>watch the sun drop into the Caribbean.</span></p>
      </div>
    </div>
  </section>

  <Included />
  <Touches />
  <Timeline data={TIMELINES.picnic} />
  <Reviews />
  <Polaroids keys={gallery} />
  <BookingSection />
  <Faq keys={faqKeys} />
  <FinalCta href="#book" />
</Base>
