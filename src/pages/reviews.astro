---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Reviews from '../components/Reviews.astro';
import Polaroids from '../components/Polaroids.astro';
import FinalCta from '../components/FinalCta.astro';
import { EXPERIENCES } from '../data/site.js';
import { breadcrumbSchema } from '../data/schema.js';

const crumbs = [{ href: '/', label: 'Home' }, { href: '/reviews/', label: 'Reviews' }];
---
<Base
  title="Reviews of our beach picnics in Aruba | One Happy Picnic"
  description="Read what guests wrote after their picnics with One Happy Picnic Aruba, from a honeymoon surprise to a 10 year anniversary. Share your own review."
  jsonld={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    title="Reviews from our guests"
    intro="Guests posted these reviews on our Facebook page after their picnics. Had a picnic with us? Add yours below."
    cta={{ href: '#leave-review', label: 'Leave a review' }}
    image={{ img: 'g-kiss', w: 900, h: 1125, alt: 'A couple kissing on patterned cushions beside a flower teepee at sunset', sizes: [600, 900] }}
  />
  <Reviews long more={false} before="Four" after="reviews, in full" id="all-reviews" />
  <Polaroids keys={['pol-proposal-hug', 'g-silhouettes', 'pol-group-arms']} before="Their" after="picnics" pill="pill-golden.webp" />

  <section class="section section--sand" id="leave-review" aria-labelledby="leave-title">
    <div class="container booking">
      <div class="booking__aside reveal">
        <div class="section-head" style="margin-bottom: 0;">
          <h2 class="h2" id="leave-title">Had a picnic with us?</h2>
          <p class="lead">Tell Zoe how it went. With your permission, we add your review to this page.</p>
        </div>
      </div>
      <div class="form-card reveal reveal-d1">
        <form class="compose" data-compose data-intro="Hi Zoe, here is my review of our picnic." data-subject="review" novalidate>
          <div class="form-grid">
            <div class="field">
              <label for="r-name">Your name</label>
              <input class="input" id="r-name" name="name" type="text" autocomplete="name" required data-label="Name" aria-describedby="r-name-error">
              <p class="field__error" id="r-name-error" role="alert"></p>
            </div>
            <div class="field">
              <label for="r-picnic">Your picnic</label>
              <select class="input" id="r-picnic" name="picnic" data-label="Picnic">
                {EXPERIENCES.map((e) => <option>{e.booking}</option>)}
              </select>
            </div>
            <fieldset class="field field--full">
              <legend>Your rating</legend>
              <div class="rating">
                {[5, 4, 3, 2, 1].map((n) => (
                  <>
                    <input type="radio" id={`r-star-${n}`} name="rating" value={`${n} out of 5`} data-label="Rating" checked={n === 5}>
                    <label for={`r-star-${n}`}><svg class="icon" aria-hidden="true"><use href="#i-star"/></svg><span class="sr-only">{n} out of 5</span></label>
                  </>
                ))}
              </div>
            </fieldset>
            <div class="field field--full">
              <label for="r-text">Your review</label>
              <textarea class="input" id="r-text" name="review" rows="5" required data-label="Review" aria-describedby="r-text-error" placeholder="The occasion, the setup, the food, the moment you remember"></textarea>
              <p class="field__error" id="r-text-error" role="alert"></p>
            </div>
            <label class="check field--full">
              <input type="checkbox" name="publish" value="Yes, you can publish it with my first name and last initial" data-label="Publish on the website">
              <span>You can publish my review with my first name and last initial.</span>
            </label>
          </div>
          <div class="form-foot">
            <button class="btn btn--primary" type="submit"><svg class="icon"><use href="#i-whatsapp-logo"/></svg> Send my review</button>
            <p>Thank you for taking the time.</p>
          </div>
          <p class="form-status" role="alert" hidden></p>
        </form>
        <div class="success" data-compose-success hidden tabindex="-1">
          <span class="success__badge" aria-hidden="true"><svg class="icon"><use href="#i-l-check"/></svg></span>
          <h3>Your review is ready to send</h3>
          <p data-success-copy>Send it to Zoe on WhatsApp or Instagram.</p>
          <div class="success__actions">
            <a class="btn btn--primary" data-send-link href="#" target="_blank" rel="noopener"><svg class="icon"><use href="#i-whatsapp-logo" data-send-icon/></svg> <span data-send-label>Open WhatsApp</span></a>
            <button class="btn btn--ghost" type="button" data-copy><svg class="icon"><use href="#i-copy"/></svg> <span>Copy review</span></button>
            <button class="btn btn--ghost" type="button" data-edit>Edit review</button>
          </div>
        </div>
      </div>
    </div>
  </section>
  <FinalCta />
</Base>
