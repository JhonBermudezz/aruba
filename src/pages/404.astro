---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | One Happy Picnic Aruba" description="This page does not exist. Head back to One Happy Picnic Aruba to plan your beach picnic." noindex>
<div class="notfound">
  <div class="notfound__bg"><img src="/assets/img/g-silhouettes-900.webp" width="900" height="900" alt=""></div>
  <div class="notfound__inner">
    <img src="/assets/img/logo-192.webp" width="72" height="72" alt="One Happy Picnic Aruba logo" style="border-radius:9999px;">
    <span class="code">ERROR 404</span>
    <h1>We could not find this page</h1>
    <p>The link may be old or mistyped. Go back to the home page to see the picnics or book a date.</p>
    <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;">
      <a class="btn btn--light" href="/">Back to home</a>
      <a class="btn btn--primary" href="/book/">Book a picnic</a>
    </div>
  </div>
</div>
</Base>
