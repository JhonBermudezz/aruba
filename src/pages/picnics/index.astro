---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ExperienceCards from '../../components/ExperienceCards.astro';
import Included from '../../components/Included.astro';
import Timeline from '../../components/Timeline.astro';
import Faq from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import { EXPERIENCES, TIMELINES, SITE } from '../../data/site.js';
import { breadcrumbSchema, faqSchema } from '../../data/schema.js';

const crumbs = [{ href: '/', label: 'Home' }, { href: '/picnics/', label: 'Picnics' }];
const faqKeys = ['price', 'length', 'beaches', 'deposit'];
const list = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  itemListElement: EXPERIENCES.map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: e.name, url: `${SITE.url}/picnics/${e.slug}/` })),
};
---
<Base
  title="Private beach picnics in Aruba | One Happy Picnic"
  description="Six ways to picnic on the beach in Aruba: sunset and moonlight picnics, proposal setups, birthdays and anniversaries, group picnics and charcuterie boards to go."
  jsonld={[breadcrumbSchema(crumbs), list, faqSchema(faqKeys)]}
>
  <PageHero
    crumbs={crumbs}
    title="Private beach picnics in Aruba"
    intro="Pick the picnic that fits your trip. Every setup is private, and Zoe and her team set it up on the sand before you arrive."
    cta={{ href: '/book/', label: 'Book a picnic' }}
    secondary={{ href: '/contact/', label: 'Ask a question' }}
    image={{ img: 'p-sunset', w: 1000, h: 1250, alt: 'A bamboo teepee with pink flowers over a picnic table and cushions on the sand at sunset' }}
  />
  <section class="section section--tight" aria-label="Picnics">
    <div class="container">
      <ExperienceCards items={EXPERIENCES} />
    </div>
  </section>
  <Included />
  <Timeline data={TIMELINES.picnic} />
  <Faq keys={faqKeys} heading="Questions about our picnics" />
  <FinalCta />
</Base>
